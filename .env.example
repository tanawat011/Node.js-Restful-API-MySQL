# Copy to .env (git-ignored); `npm start`, `npm run migrate` and `npm test`
# read it. DEV ONLY: placeholder passwords for the local MySQL in
# compose.yaml. Never put real credentials in this file.

DB_HOST=127.0.0.1
DB_PORT=13307
DB_USER=app
DB_PASSWORD=change-me-dev-only
DB_NAME=inform_repair
MYSQL_ROOT_PASSWORD=change-me-root-dev-only

# `npm run migrate` makes user 1, superadmin, with this password.
# Leave it empty to make no administrator.
SEED_ADMIN_PASSWORD=change-me-admin-dev-only

# The API
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:4200
# How long a sign-in lasts
SESSION_TTL_HOURS=8

# The tests drop and remake the tables of this database; compose creates it.
TEST_DB_NAME=inform_repair_test
